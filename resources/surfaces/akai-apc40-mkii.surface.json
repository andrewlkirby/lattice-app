{
  "lattice": "surface",
  "version": 1,
  "name": "Akai APC40 MKII",
  "manufacturer": "Akai Professional",
  "verified": false,
  "source": "APC40 Mk2 Communication Protocol (Akai Professional): the mode sysex, clip and scene notes, the per-channel track buttons, the knobs.",
  "notes": "Unverified: written from the protocol document, not yet tried on a device. The device knobs are encoders 1 to 8 and the track knobs 9 to 16; the faders aren't used yet.",
