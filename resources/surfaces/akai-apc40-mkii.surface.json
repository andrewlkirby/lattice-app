    { "role": "trackSelect", "index": 7, "note": 51, "channel": 8, "led": "single" },
    { "role": "shift", "note": 98 },
    { "role": "play", "note": 91, "led": "single" },
    { "role": "record", "note": 93, "led": "single" },
    { "role": "mode.session", "note": 102, "led": "single" },
    { "role": "nav.up", "note": 94, "led": "single" },
    { "role": "nav.down", "note": 95, "led": "single" },
    { "role": "nav.right", "note": 96, "led": "single" },
    { "role": "nav.left", "note": 97, "led": "single" },
