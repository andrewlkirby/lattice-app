    { "role": "trackSelect", "index": 2, "note": 51, "channel": 3, "led": "single" },
    { "role": "trackSelect", "index": 3, "note": 51, "channel": 4, "led": "single" },
    { "role": "trackSelect", "index": 4, "note": 51, "channel": 5, "led": "single" },
    { "role": "trackSelect", "index": 5, "note": 51, "channel": 6, "led": "single" },
