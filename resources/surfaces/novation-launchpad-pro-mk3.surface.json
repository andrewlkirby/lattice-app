{
  "lattice": "surface",
  "version": 1,
  "name": "Novation Launchpad Pro MK3",
  "manufacturer": "Novation",
  "verified": false,
  "source": "Launchpad Pro [MK3] Programmer's Reference Manual (Novation).",
  "notes": "Unverified: written from the manual, not yet tried on a device. Chord is Layout, Custom is Clip, Sequencer is Scale and Projects is Browse; Volume is Mix. Record Arm, Pan and Sends have no role yet.",
  "ports": { "input": ["LPProMK3 MIDI"], "output": ["LPProMK3 MIDI"] },
  "init": ["F0 00 20 29 02 0E 0E 01 F7"],
  "exit": ["F0 00 20 29 02 0E 0E 00 F7"],
  "grid": {
    "rows": 8, "columns": 8, "message": "note",
    "first": 81, "rowStep": -10, "columnStep": 1,
    "velocity": true, "aftertouch": "polyphonic",
    "led": { "kind": "palette", "palette": "novation", "blinkChannel": 2, "pulseChannel": 3 }
  },
  "leds": { "rgb": { "kind": "palette", "palette": "novation", "blinkChannel": 2, "pulseChannel": 3 } },
  "buttons": [
    { "role": "shift", "cc": 90, "led": "rgb" },
    { "role": "nav.left", "cc": 91, "led": "rgb" },
    { "role": "nav.right", "cc": 92, "led": "rgb" },
    { "role": "mode.session", "cc": 93, "led": "rgb" },
    { "role": "mode.note", "cc": 94, "led": "rgb" },
    { "role": "layout", "cc": 95, "led": "rgb" },
    { "role": "mode.clip", "cc": 96, "led": "rgb" },
    { "role": "scale", "cc": 97, "led": "rgb" },
    { "role": "mode.browse", "cc": 98, "led": "rgb" },
    { "role": "nav.up", "cc": 80, "led": "rgb" },
    { "role": "nav.down", "cc": 70, "led": "rgb" },
    { "role": "delete", "cc": 60, "led": "rgb" },
    { "role": "duplicate", "cc": 50, "led": "rgb" },
    { "role": "quantize", "cc": 40, "led": "rgb" },
    { "role": "fixedLength", "cc": 30, "led": "rgb" },
    { "role": "play", "cc": 20, "led": "rgb" },
    { "role": "record", "cc": 10, "led": "rgb" },
    { "role": "mute", "cc": 2, "led": "rgb" },
    { "role": "solo", "cc": 3, "led": "rgb" },
    { "role": "mode.mix", "cc": 4, "led": "rgb" },
    { "role": "mode.device", "cc": 7, "led": "rgb" },
    { "role": "stopClip", "cc": 8, "led": "rgb" },
    { "role": "trackSelect", "cc": [101, 102, 103, 104, 105, 106, 107, 108], "led": "rgb" },
    { "role": "scene", "cc": [89, 79, 69, 59, 49, 39, 29, 19], "led": "rgb" }
  ]
}
