{
  "lattice": "surface",
  "version": 1,
  "name": "Novation Launchpad Mini MK3",
  "manufacturer": "Novation",
  "verified": false,
  "source": "Launchpad Mini [MK3] Programmer's Reference Manual (Novation).",
  "notes": "Unverified: written from the manual, not yet tried on a device. Its pads have no velocity. Drums is Note, Keys is Layout, and User is Shift.",
  "ports": { "input": ["LPMiniMK3 MIDI"], "output": ["LPMiniMK3 MIDI"] },
  "init": ["F0 00 20 29 02 0D 0E 01 F7"],
  "exit": ["F0 00 20 29 02 0D 0E 00 F7"],
